# Copy this file to .env.production on the server and replace every placeholder.
# Never commit the filled file.

# Host ports consumed by the reverse proxy. They bind to 127.0.0.1 only.
WEB_HTTP_PORT=3000
API_HTTP_PORT=3001

# PostgreSQL container
POSTGRES_USER=sanad
POSTGRES_PASSWORD=replace-with-a-long-random-database-password
POSTGRES_DB=sanad_db

# Backend security and public origins
JWT_ACCESS_SECRET=replace-with-a-unique-random-value-of-at-least-32-characters
JWT_REFRESH_SECRET=replace-with-another-unique-random-value-of-at-least-32-characters
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=30d
PAYMENT_WEBHOOK_SECRET=replace-with-a-unique-random-value-of-at-least-32-characters
FRONTEND_URL=https://example.com
CORS_ORIGINS=https://example.com
TRUST_PROXY=1
SWAGGER_ENABLED=false
REQUIRE_EMAIL_VERIFICATION=true
EMAIL_VERIFICATION_EXPIRES_IN=24h

# Email: configure Resend or SMTP.
RESEND_API_KEY=
EMAIL_FROM=noreply@example.com
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_SECURE=true
SMTP_FROM_EMAIL=noreply@example.com

# Durable file storage. Leave all R2 values empty only when using the uploads volume.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
R2_PUBLIC_URL=
R2_ENDPOINT=

# Optional integrations and monitoring
GOOGLE_CLIENT_ID=
SENTRY_DSN=
SENTRY_ENVIRONMENT=production

# Payment is arranged externally, then confirmed by an administrator.
PAYMENT_PROVIDER=manual
PAYMENT_SECRET_KEY=

THROTTLE_TTL=60
THROTTLE_LIMIT=60
MAX_FILE_SIZE=10485760

# Frontend public values are embedded during image build.
NEXT_PUBLIC_API_BASE_URL=https://api.example.com/api/v1
NEXT_PUBLIC_SITE_URL=https://example.com
NEXT_PUBLIC_MEDIA_BASE_URL=https://api.example.com
NEXT_PUBLIC_CHECKOUT_MODE=manual
NEXT_PUBLIC_GOOGLE_CLIENT_ID=
NEXT_PUBLIC_SENTRY_DSN=
NEXT_PUBLIC_SENTRY_ENVIRONMENT=production
NEXT_PUBLIC_SENTRY_TRACES_SAMPLE_RATE=0.1
