# =====================================================
# SANAD Backend - Environment Configuration
# =====================================================
# Copy this file to .env and fill in the values.
# Generate the secrets with: npm run gen:secrets
# Validate a filled-in environment with: npm run build && npm run preflight

# Application
NODE_ENV=development
PORT=3001

# Database
# Append connection_limit and pool_timeout to size the Prisma pool. The default
# is (physical CPUs * 2 + 1) per instance, which can exhaust Postgres
# max_connections once you run several instances or a serverless platform.
DATABASE_URL=postgresql://postgres:YOUR_PASSWORD@localhost:5432/sanad_db?schema=public&connection_limit=10&pool_timeout=20
POSTGRES_USER=postgres
POSTGRES_PASSWORD=generate-a-strong-local-password
POSTGRES_DB=sanad_db
POSTGRES_PORT=5432

# Separate database used by `npm run test:integration`. The current suite is
# read-only, but keep it isolated so future integration tests cannot affect
# development data.
INTEGRATION_DATABASE_URL=postgresql://postgres:YOUR_PASSWORD@localhost:5432/sanad_test_db?schema=public

# JWT
# Generate each secret independently, for example: openssl rand -hex 32
JWT_ACCESS_SECRET=replace-with-a-unique-random-value-of-at-least-32-characters
JWT_REFRESH_SECRET=replace-with-another-unique-random-value-of-at-least-32-characters
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=30d

# Frontend
FRONTEND_URL=http://localhost:3000
CORS_ORIGINS=http://localhost:3000
SWAGGER_ENABLED=true

# Proxy / load balancer
# Rate limiting buckets by client IP, and request.ip resolves to the nearest
# proxy unless Express is told how many hops to trust. Leaving this unset in
# production is a startup error, because the wrong value makes every client
# share a single rate-limit bucket.
#   false      directly exposed, no proxy in front
#   1          one proxy hop (typical ALB / Nginx / Cloudflare setup)
#   10.0.0.0/8 trust only these proxy addresses (comma-separated list)
TRUST_PROXY=false

# Error tracking (optional; no-op when SENTRY_DSN is empty)
SENTRY_DSN=
SENTRY_ENVIRONMENT=

# Cloudflare R2 / S3-Compatible Storage
# Required in production; without it uploads fall back to local disk.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=sanad-files
R2_PUBLIC_URL=
R2_ENDPOINT=

# Email (Resend or SMTP). Production requires one of the two.
RESEND_API_KEY=
EMAIL_FROM=noreply@sanad.ae

# Optional SMTP Configuration (Gmail, Amazon SES, Brevo, custom SMTP)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_SECURE=false
SMTP_FROM_EMAIL=noreply@sanad.ae

# Email verification
# When true, unverified accounts cannot log in. Turning this on for an existing
# database locks out every account created before verification existed, so
# backfill email_verified first.
REQUIRE_EMAIL_VERIFICATION=false
EMAIL_VERIFICATION_EXPIRES_IN=24h

# Google Identity Services (OAuth 2.0 Web client). This is a public client ID,
# not a client secret. Add http://localhost:3000 and the production frontend
# origin under Authorized JavaScript origins in Google Cloud Console.
GOOGLE_CLIENT_ID=

# Payment
# mock: local signed-webhook simulation only (rejected in production)
# manual: orders wait for an admin to confirm money collected through an
# external payment link, QR code, bank transfer, cash, or another channel.
# bypass: deliberately accept orders without charging while company payment
# paperwork is pending. The API records a zero charged amount and confirms the
# order immediately. Replace this with a real provider before paid checkout.
PAYMENT_PROVIDER=mock
PAYMENT_SECRET_KEY=
PAYMENT_WEBHOOK_SECRET=generate-at-least-32-random-characters

# One-time admin bootstrap (used only by `npm run db:seed-admin`)
ADMIN_NAME=Sanad Administrator
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Rate Limiting
THROTTLE_TTL=60
THROTTLE_LIMIT=60

# File Upload
MAX_FILE_SIZE=10485760
