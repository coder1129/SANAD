{
  "name": "backend",
  "version": "0.0.1",
  "description": "",
  "author": "",
  "private": true,
  "license": "UNLICENSED",
  "scripts": {
    "build": "nest build",
    "dev": "nest start --watch",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:debug": "nest start --debug --watch",
    "start:prod": "node dist/main",
    "lint": "oxlint src/ test/",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:cov": "vitest run --coverage",
    "test:debug": "vitest --inspect-brk --no-file-parallelism",
    "test:e2e": "vitest run --config ./vitest.config.e2e.mts",
    "test:integration": "vitest run --config ./vitest.config.integration.mts",
    "test:all": "npm run lint && npx tsc --noEmit && npm run test:cov && npm run test:e2e && npm run test:integration && npm run build",
    "preflight": "node scripts/preflight.cjs",
    "preflight:production": "node scripts/preflight.cjs --production",
    "staging:smoke": "node scripts/staging-smoke.cjs",
    "load:staging": "k6 run test/load/staging.k6.js",
    "gen:secrets": "node scripts/gen-secrets.cjs",
    "db:migrate": "prisma migrate deploy",
    "db:backup": "node scripts/db-backup.cjs",
    "db:restore:check": "node scripts/db-restore-check.cjs",
    "db:seed-admin": "prisma db seed",
    "db:seed-packages": "node -r dotenv/config prisma/seed-packages.cjs"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1119.0",
    "@aws-sdk/s3-request-presigner": "^3.1119.0",
    "@nestjs/common": "^12.0.1",
    "@nestjs/config": "^12.0.0",
    "@nestjs/core": "^12.0.1",
    "@nestjs/jwt": "^12.0.1",
    "@nestjs/passport": "^12.0.0",
    "@nestjs/platform-express": "^12.0.1",
    "@nestjs/schedule": "^12.0.1",
    "@nestjs/swagger": "^12.0.0",
    "@prisma/client": "6.19.3",
    "@sentry/node": "^10.71.0",
    "argon2": "^0.45.1",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "dotenv": "^17.4.2",
    "helmet": "^8.3.0",
    "nodemailer": "^10.0.1",
    "passport": "^0.7.0",
    "passport-jwt": "^4.0.1",
    "pino": "^10.3.1",
    "pino-pretty": "^13.1.3",
    "prisma": "6.19.3",
    "reflect-metadata": "^0.2.2",
    "resend": "^6.24.0",
    "rxjs": "^7.8.1",
    "uuid": "^14.0.2"
  },
  "devDependencies": {
    "@nestjs/cli": "^12.0.0",
    "@nestjs/schematics": "^12.0.0",
    "@nestjs/testing": "^12.0.1",
    "@types/express": "^5.0.0",
    "@types/multer": "^2.2.0",
    "@types/node": "^24.0.0",
    "@types/nodemailer": "^8.0.1",
    "@types/passport-jwt": "^4.0.1",
    "@types/supertest": "^7.0.0",
    "@types/uuid": "^10.0.0",
    "@vitest/coverage-v8": "^4.1.2",
    "oxlint": "^1.58.0",
    "prettier": "^3.4.2",
    "supertest": "^7.0.0",
    "typescript": "^6.0.2",
    "vitest": "^4.1.2"
  },
  "overrides": {
    "deepmerge-ts": "8.0.0",
    "multer": "2.3.0"
  }
}
