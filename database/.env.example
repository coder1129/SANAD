-- =====================================================
-- Environment Configuration Files
-- =====================================================

-- .env.example - نموذج ملف الإعدادات
-- يرجى نسخ هذا الملف إلى .env وتعديل القيم

# Database Configuration
DB_HOST=localhost
DB_PORT=5432
DB_NAME=sanad_db
DB_USER=sanad_app
DB_PASSWORD=Sanad@App2026!
DB_SSL=false
DB_POOL_MIN=2
DB_POOL_MAX=20

# Application
APP_NAME=Sanad
APP_URL=https://sanad.ae
APP_ENV=development
APP_DEBUG=true
APP_PORT=3000

# Security
SESSION_SECRET=your-session-secret-here-change-in-production
JWT_SECRET=your-jwt-secret-here-change-in-production
JWT_EXPIRY=7d
BCRYPT_ROUNDS=10

# VAT Configuration
VAT_PERCENTAGE=5
CURRENCY=AED

# Payment Gateways
# Telr
TELR_STORE_ID=your-telr-store-id
TELR_AUTH_KEY=your-telr-auth-key
TELR_TEST_MODE=true
TELR_RETURN_URL=${APP_URL}/payment/telr/return
TELR_CANCEL_URL=${APP_URL}/payment/telr/cancel

# PayTabs
PAYTABS_PROFILE_ID=your-paytabs-profile-id
PAYTABS_SERVER_KEY=your-paytabs-server-key
PAYTABS_REGION=ARE
PAYTABS_CURRENCY=AED
PAYTABS_RETURN_URL=${APP_URL}/payment/paytabs/return
PAYTABS_CANCEL_URL=${APP_URL}/payment/paytabs/cancel

# Email Configuration
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-app-password
SMTP_FROM_EMAIL=noreply@sanad.ae
SMTP_FROM_NAME=سند - Sanad

# File Upload
MAX_FILE_SIZE=10485760
ALLOWED_FILE_TYPES=pdf,docx,doc,txt
UPLOAD_DIR=./uploads

# Session & Security
SESSION_TIMEOUT=3600
MAX_LOGIN_ATTEMPTS=5
ACCOUNT_LOCK_DURATION=900

# Rate Limiting
RATE_LIMIT_WINDOW=900000
RATE_LIMIT_MAX_REQUESTS=100

# Logging
LOG_LEVEL=info
LOG_FILE=./logs/app.log

# Redis (Optional - for sessions and caching)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# AWS S3 (Optional - for file storage)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=me-south-1
AWS_S3_BUCKET=sanad-files

# Frontend URL (if separate)
FRONTEND_URL=https://sanad.ae
CORS_ORIGIN=${FRONTEND_URL}

# Admin Configuration
ADMIN_EMAIL=admin@sanad.ae
SUPPORT_EMAIL=support@sanad.ae
CONTACT_PHONE=+971501234567
