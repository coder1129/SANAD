# Every NEXT_PUBLIC_* value is inlined into the browser bundle.
# Never put secrets, database credentials, or tokens in this file.

# Backend API base URL, including the /api/v1 version prefix.
# Example: https://backend.example.com/api/v1
NEXT_PUBLIC_API_BASE_URL=

# Public origin of this frontend, used for canonical URLs and metadata.
NEXT_PUBLIC_SITE_URL=

# Base URL that uploaded media is served from.
NEXT_PUBLIC_MEDIA_BASE_URL=

# manual hides online card/Apple Pay checkout and sends customers to WhatsApp.
# gateway restores the preserved online payment route and controls.
NEXT_PUBLIC_CHECKOUT_MODE=manual

# Google OAuth 2.0 Web client ID. This is public and must match the backend
# GOOGLE_CLIENT_ID. Add http://localhost:3000 as an Authorized JavaScript origin.
NEXT_PUBLIC_GOOGLE_CLIENT_ID=

# Optional public R2/custom-media origin used by Next.js image optimization.
R2_PUBLIC_URL=

# Optional production error monitoring. Public DSNs are safe to expose; auth
# tokens are server/build secrets and must only be configured in the host.
NEXT_PUBLIC_SENTRY_DSN=
NEXT_PUBLIC_SENTRY_ENVIRONMENT=development
NEXT_PUBLIC_SENTRY_TRACES_SAMPLE_RATE=0.1
SENTRY_DSN=
SENTRY_ENVIRONMENT=development
SENTRY_AUTH_TOKEN=
SENTRY_ORG=
SENTRY_PROJECT=
