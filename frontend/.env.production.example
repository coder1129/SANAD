# Vercel production environment template.
# Add these keys in Vercel Project Settings > Environment Variables.
# Do not rename this file to .env.production with real values and commit it.

# Public URL of the deployed NestJS API, including the /api/v1 prefix.
NEXT_PUBLIC_API_BASE_URL=https://api.your-domain.com/api/v1

# Canonical public URL of the Vercel frontend. Do not add a trailing slash.
NEXT_PUBLIC_SITE_URL=https://www.your-domain.com

# Public base URL used to serve uploaded package and order media.
# Use the API storage URL temporarily, or the R2/custom-domain URL in production.
NEXT_PUBLIC_MEDIA_BASE_URL=https://media.your-domain.com

# Must match GOOGLE_CLIENT_ID in the backend deployment.
NEXT_PUBLIC_GOOGLE_CLIENT_ID=000000000000-example.apps.googleusercontent.com

# Optional: add this only when package images are served directly from R2.
# It is used by next.config.ts to allow optimized remote images.
R2_PUBLIC_URL=https://media.your-domain.com

# Optional Sentry monitoring. Keep SENTRY_AUTH_TOKEN private in Vercel.
NEXT_PUBLIC_SENTRY_DSN=
NEXT_PUBLIC_SENTRY_ENVIRONMENT=production
NEXT_PUBLIC_SENTRY_TRACES_SAMPLE_RATE=0.1
SENTRY_DSN=
SENTRY_ENVIRONMENT=production
SENTRY_AUTH_TOKEN=
SENTRY_ORG=
SENTRY_PROJECT=
